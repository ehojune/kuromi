# === Slack (필수) ===
# https://api.slack.com/apps 에서 앱 생성 후 발급 (README 참고)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# === 비서 설정 (선택) ===
ASSISTANT_NAME=쿠로미
KUROMI_MODEL=claude-sonnet-5-5

# 보이스: off | local (PC 스피커) | slack (음성파일 업로드) | both
VOICE_MODE=local
# 한국어 보이스 예시: ko-KR-SunHiNeural(여), ko-KR-InJoonNeural(남), ko-KR-HyunsuMultilingualNeural
VOICE_NAME=ko-KR-SunHiNeural
VOICE_MAX_CHARS=300

# 지식베이스 경로
LLM_WIKI_PATH=C:\Users\admin\llm-wiki

# === Notion / 브리핑 / 논문 ===
NOTION_TOKEN=ntn_...
NOTION_TRACKER_DB_ID=
OWNER_SLACK_ID=
NCBI_EMAIL=

# === Google Calendar (직접 연동, 선택) ===
# 서비스 계정 JSON 키 경로 (README "구글 캘린더 연결" 참고)
GOOGLE_CALENDAR_CREDENTIALS_PATH=
# 서비스 계정과 공유한 캘린더 ID (보통 본인 Gmail 주소, 기본 캘린더면 primary)
GOOGLE_CALENDAR_ID=

# === GitHub 개발 동향 (선택) ===
# 로컬 Pakuri 프로젝트 경로. 수집은 Pakuri 예약 작업에서 하고 kuromi는 결과를 읽는다.
PAKURI_PATH=

# === Claude 인증 ===
# 기본적으로 Claude Code 로그인(구독)을 그대로 사용하므로 비워둬도 됨.
# API 키를 따로 쓰려면 주석 해제:
# ANTHROPIC_API_KEY=sk-ant-...
# 구독 기반 장기 토큰 (claude setup-token 으로 발급) — 헤드리스 실행에 권장:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
